# Copiar a .env.local (desarrollo) o cargar en Vercel → Settings → Environment Variables.
# Ningún valor real va en este archivo.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
# Solo servidor. Salta la RLS: nunca en el navegador ni en las webs.
SUPABASE_SERVICE_ROLE_KEY=
# Solo para `node scripts/migrar.mjs` desde una máquina de confianza. No va en Vercel.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Sal aleatoria para anonimizar IP (límite de envíos). Cualquier cadena larga.
IP_SALT=

# --- Correo, uno por empresa (JSON en una sola línea) ---
# SMTP, por ejemplo Microsoft 365 (requiere «SMTP autenticado» activo en el buzón):
# CORREO_LP={"tipo":"smtp","host":"smtp.office365.com","puerto":587,"usuario":"reclamos@laboratoriospacheco.com","clave":"…","remitente":"Laboratorios Pacheco <reclamos@laboratoriospacheco.com>"}
# Resend (el dominio debe estar verificado en Resend):
# CORREO_WOLI={"tipo":"resend","clave":"re_…","remitente":"WOLI <no-reply@wlicargo.com>"}
CORREO_LP=
CORREO_QMEDICAL=
CORREO_WOLI=

# --- Catálogo editable: publicar la web desde el panel ---
# «Deploy hook» del proyecto de la web en Vercel (Settings → Git → Deploy Hooks).
# Sin esto, la pantalla del catálogo no ofrece el botón de publicar.
PUBLICAR_QMEDICAL=

# Dónde se sirven hoy las fotografías del catálogo que vinieron con la web.
# Solo hace falta mientras el dominio apunte a otro hosting; si se deja vacío
# se usa `empresas.sitio_url`.
WEB_QMEDICAL=
